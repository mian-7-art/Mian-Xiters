                            <Border.Background>
                                <SolidColorBrush Color="#121215"/>
                            </Border.Background>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Disable Hyper-V" FontSize="11.5" FontWeight="Bold" Foreground="#F4F4F5"/>
                                    <TextBlock Text="Optimize Windows for emulators" FontSize="9.5" Foreground="#A1A1AA"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="[ FIX ]" Style="{StaticResource KeybindBadgeBtn}" VerticalAlignment="Center" Click="BtnDisableHyperV_Click"/>
                            </Grid>
                        </Border>

                        <!-- COLOR THEME PALETTE BAR -->
                        <Border Style="{StaticResource AnimatedRowCard}">
                            <Border.Background>
                                <SolidColorBrush Color="#121215"/>
                            </Border.Background>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Margin="0,0,0,8">
                                    <TextBlock Text="App Accent Theme" FontSize="11.5" FontWeight="Bold" Foreground="#F4F4F5"/>
                                    <TextBlock Text="Select your favorite color theme" FontSize="9.5" Foreground="#A1A1AA"/>
                                </StackPanel>

                                <!-- Interactive Color Palette Bar -->
                                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">
                                    <!-- Red Color Swatch -->
                                    <Border Width="28" Height="28" CornerRadius="14" Background="#DC2626" Margin="4,0"
                                            BorderBrush="#FFFFFF" BorderThickness="2" Cursor="Hand"
                                            MouseLeftButtonDown="ColorSwatch_Click" Tag="#DC2626" ToolTip="Crimson Red"/>

                                    <!-- Purple Color Swatch -->
                                    <Border Width="28" Height="28" CornerRadius="14" Background="#A855F7" Margin="4,0"
                                            BorderBrush="#27272A" BorderThickness="1.5" Cursor="Hand"
                                            MouseLeftButtonDown="ColorSwatch_Click" Tag="#A855F7" ToolTip="Neon Purple"/>

                                    <!-- Cyan Blue Color Swatch -->
                                    <Border Width="28" Height="28" CornerRadius="14" Background="#06B6D4" Margin="4,0"
                                            BorderBrush="#27272A" BorderThickness="1.5" Cursor="Hand"
                                            MouseLeftButtonDown="ColorSwatch_Click" Tag="#06B6D4" ToolTip="Cyber Cyan"/>

                                    <!-- Emerald Green Color Swatch -->
                                    <Border Width="28" Height="28" CornerRadius="14" Background="#10B981" Margin="4,0"
                                            BorderBrush="#27272A" BorderThickness="1.5" Cursor="Hand"
                                            MouseLeftButtonDown="ColorSwatch_Click" Tag="#10B981" ToolTip="Emerald Green"/>

                                    <!-- Amber Gold Color Swatch -->
                                    <Border Width="28" Height="28" CornerRadius="14" Background="#F59E0B" Margin="4,0"
                                            BorderBrush="#27272A" BorderThickness="1.5" Cursor="Hand"
                                            MouseLeftButtonDown="ColorSwatch_Click" Tag="#F59E0B" ToolTip="Electric Gold"/>

                                    <!-- Silver White Color Swatch -->
                                    <Border Width="28" Height="28" CornerRadius="14" Background="#E4E4E7" Margin="4,0"
                                            BorderBrush="#27272A" BorderThickness="1.5" Cursor="Hand"
                                            MouseLeftButtonDown="ColorSwatch_Click" Tag="#E4E4E7" ToolTip="Platinum Silver"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>

                </Grid>
            </ScrollViewer>

                <!-- Footer (Logout Button, Live Status Badge & White Watermark) -->
                <Grid Grid.Row="2" Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Mini Sleek Logout Icon Button -->
                    <Button Grid.Column="0" x:Name="BtnLogout" Click="BtnLogout_Click" Style="{StaticResource MiniIconButton}" ToolTip="Log Out" Margin="0,0,6,0">
                        <TextBlock Text="🚪" FontSize="11" Foreground="#EF4444" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>

                    <!-- Live Engine Status & Stream Proof Badges -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#121215" BorderBrush="#27272A" BorderThickness="1" CornerRadius="6" Padding="6,3" Margin="0,0,4,0" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtEngineStatus" Text="🔴 Searching..." FontSize="9.5" FontWeight="Bold" Foreground="#EF4444" VerticalAlignment="Center"/>
                        </Border>
                        <Border Background="#121215" BorderBrush="#27272A" BorderThickness="1" CornerRadius="6" Padding="6,3" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtStreamProofStatus" Text="🛡️ Stealth: OFF" FontSize="9.5" FontWeight="Bold" Foreground="#8E8E93" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>

                    <!-- Pure White Watermark Signature: dev : 1nOnlyMian -->
                    <TextBlock Grid.Column="2" x:Name="TxtMainWatermark" Text="dev : 1nOnlyMian"
                               FontSize="9.5" FontWeight="Bold" Foreground="#FFFFFF"
                               HorizontalAlignment="Right" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                        <TextBlock.RenderTransform>
                            <ScaleTransform x:Name="WatermarkScaleMain" ScaleX="1.0" ScaleY="1.0"/>
                        </TextBlock.RenderTransform>
                    </TextBlock>
                </Grid>
            </Grid>

        </Grid>
    </Border>

</Window>
