                                               VerticalAlignment="Center" Click="FeatureToggle_Click"/>
                            </Grid>
                        </Border>



                        <!-- Glitch Fire Card -->
                        <Border x:Name="RowCard7" Style="{StaticResource AnimatedRowCard}" Cursor="Hand" MouseLeftButtonDown="Card_Click">
                            <Border.Background>
                                <SolidColorBrush Color="#121215"/>
                            </Border.Background>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Glitch Fire" FontSize="11.5" FontWeight="Bold" Foreground="#F4F4F5"/>
                                    <TextBlock Text="Instant glitch fire camera angle" FontSize="9.5" Foreground="#A1A1AA"/>
                                </StackPanel>
                                <ToggleButton x:Name="ToggleGlitchFire" Grid.Column="1"
                                               IsChecked="False" Style="{StaticResource RowToggleSwitch}"
                                               VerticalAlignment="Center" Click="FeatureToggle_Click"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- SECTION 4 CONTENT: EXTREME -->
                    <StackPanel x:Name="SectionContentExtreme" Visibility="Collapsed">
                        <!-- Fast Landing Card -->
                        <Border x:Name="RowCard8" Style="{StaticResource AnimatedRowCard}" Cursor="Hand" MouseLeftButtonDown="Card_Click">
                            <Border.Background>
                                <SolidColorBrush Color="#121215"/>
                            </Border.Background>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Fast Landing" FontSize="11.5" FontWeight="Bold" Foreground="#F4F4F5"/>
                                    <TextBlock x:Name="TxtFastLandingSub" Text="Instant parachute ground speed" FontSize="9.5" Foreground="#A1A1AA"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="BtnFastLandingKey" Content="[ NONE ]" Style="{StaticResource KeybindBadgeBtn}" Margin="0,0,6,0" Click="BtnFastLandingKey_Click" ToolTip="Click to assign keybind"/>
                                    <ToggleButton x:Name="ToggleFastLanding" IsChecked="False" Style="{StaticResource RowToggleSwitch}" VerticalAlignment="Center" Click="FeatureToggle_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Camera Card -->
                        <Border x:Name="RowCard9" Style="{StaticResource AnimatedRowCard}" Cursor="Hand" MouseLeftButtonDown="Card_Click">
                            <Border.Background>
                                <SolidColorBrush Color="#121215"/>
                            </Border.Background>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Camera" FontSize="11.5" FontWeight="Bold" Foreground="#F4F4F5"/>
                                    <TextBlock Text="Extended view &amp; camera height [Caps Lock]" FontSize="9.5" Foreground="#A1A1AA"/>
                                </StackPanel>
                                <ToggleButton x:Name="ToggleCameraView" Grid.Column="1"
                                               IsChecked="False" Style="{StaticResource RowToggleSwitch}"
                                               VerticalAlignment="Center" Click="FeatureToggle_Click"/>
