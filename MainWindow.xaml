                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Scope Tracking" FontSize="11.5" FontWeight="Bold" Foreground="#F4F4F5"/>
                                    <TextBlock Text="2x scope safe tracking enhancement" FontSize="9.5" Foreground="#A1A1AA"/>
                                </StackPanel>
                                <ToggleButton x:Name="ToggleScopeTracking" Grid.Column="1"
                                               IsChecked="False" Style="{StaticResource RowToggleSwitch}"
                                               VerticalAlignment="Center" Click="FeatureToggle_Click"/>
                            </Grid>
                        </Border>

                        <!-- 120 FPS Unlock Card -->
                        <Border x:Name="RowCard120Fps" Style="{StaticResource AnimatedRowCard}" Cursor="Hand" MouseLeftButtonDown="Card_Click">
                            <Border.Background>
                                <SolidColorBrush Color="#121215"/>
                            </Border.Background>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="120 FPS Unlock" FontSize="11.5" FontWeight="Bold" Foreground="#F4F4F5"/>
                                    <TextBlock Text="Unlock max frame rate limit" FontSize="9.5" Foreground="#A1A1AA"/>
