                                    <ToggleButton x:Name="ToggleEspTeam" Grid.Column="1"
                                                   IsChecked="False" Style="{StaticResource RowToggleSwitch}"
                                                   VerticalAlignment="Center" Click="SubEspToggle_Click"/>
