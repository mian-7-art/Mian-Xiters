                            <Border.Background>
                                <SolidColorBrush Color="#121215"/>
                            </Border.Background>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Sniper Scope" FontSize="11.5" FontWeight="Bold" Foreground="#F4F4F5"/>
                                    <TextBlock Text="Enhanced scope zoom &amp; fov" FontSize="9.5" Foreground="#A1A1AA"/>
                                </StackPanel>
                                <ToggleButton x:Name="ToggleScopeXit" Grid.Column="1"
                                               IsChecked="False" Style="{StaticResource RowToggleSwitch}"
                                               VerticalAlignment="Center" Click="FeatureToggle_Click"/>
                            </Grid>
                        </Border>

                        <!-- Sniper Switch Card -->
                        <Border x:Name="RowCard4" Style="{StaticResource AnimatedRowCard}" Cursor="Hand" MouseLeftButtonDown="Card_Click">
                            <Border.Background>
                                <SolidColorBrush Color="#121215"/>
                            </Border.Background>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Sniper Switch" FontSize="11.5" FontWeight="Bold" Foreground="#F4F4F5"/>
                                    <TextBlock Text="Instant weapon swap &amp; shoot" FontSize="9.5" Foreground="#A1A1AA"/>
                                </StackPanel>
                                <ToggleButton x:Name="ToggleNoRecoil" Grid.Column="1"
