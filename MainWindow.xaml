                                    <TextBlock Text="Anti-detection protection" FontSize="9.5" Foreground="#A1A1AA"/>
                                </StackPanel>
                                <ToggleButton x:Name="ToggleSteamMode" Grid.Column="1"
                                               IsChecked="False" Style="{StaticResource RowToggleSwitch}"
                                               VerticalAlignment="Center" Click="ToggleSteamMode_Click"/>
                            </Grid>
                        </Border>

