                                </Grid>
                            </Border>

                            <!-- 10. Distance Meter Card -->
                            <Border x:Name="RowCardEspDistance" Style="{StaticResource AnimatedRowCard}" Cursor="Hand" MouseLeftButtonDown="Card_Click">
