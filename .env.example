# Core Discord Credentials
# Obtain these from: https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_bot_client_id_here
GUILD_ID=your_primary_server_id_here

# (Optional) External Webhook for Out-of-Band Incident Reporting
LOG_WEBHOOK_URL=

# Zero-Tolerance Velocity Limits (Sliding Window: 10 Seconds)
LIMIT_CHANNEL_DELETE=2
LIMIT_CHANNEL_CREATE=3
LIMIT_ROLE_DELETE=2
LIMIT_ROLE_CREATE=2
LIMIT_BAN=3
LIMIT_KICK=3
LIMIT_WEBHOOK=1
LIMIT_EMOJI_DELETE=3
LIMIT_STICKER_DELETE=3

# Anti-Raid & Mass-Join Shield Limits
LIMIT_RAID_JOINS=5
MIN_ACCOUNT_AGE_DAYS=3
QUARANTINE_DEFAULT_AVATAR=true
MAX_MENTIONS=4
