<Window x:Class="EspLib.EspOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EspOverlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        IsHitTestVisible="False"
        Focusable="False"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize">
    <!-- Transparent canvas — rendered in code-behind using DrawingContext -->
    <Canvas x:Name="EspCanvas" Background="Transparent"/>
</Window>
