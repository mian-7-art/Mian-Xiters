<Window x:Class="WpfApp1.MaintenanceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MIAN XITERS - Under Maintenance"
        Height="250" Width="450"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Border Background="#09090C"
            BorderBrush="#FF0033"
            BorderThickness="1.5"
            CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect Color="#FF0033" BlurRadius="25" ShadowDepth="0" Opacity="0.5"/>
        </Border.Effect>

        <Grid Margin="24,18,24,20">
            <Grid.RowDefinitions>
                <!-- Title Bar -->
                <RowDefinition Height="Auto"/>
                <!-- Content / Icon / Message -->
                <RowDefinition Height="*"/>
                <!-- Button -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="10" Height="10" CornerRadius="5" Background="#FF0033" Margin="0,0,10,0">
                        <Border.Effect>
                            <DropShadowEffect Color="#FF0033" BlurRadius="10" ShadowDepth="0" Opacity="0.9"/>
                        </Border.Effect>
                    </Border>
                    <TextBlock Text="MIAN XITERS"
                               FontFamily="Bahnschrift, Segoe UI Black, Arial Black"
                               FontWeight="Black"
                               FontSize="15"
                               Foreground="#FFFFFF"/>
                    <Border Background="#1C1315"
                            BorderBrush="#FF0033"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="6,2"
                            Margin="8,0,0,0">
                        <TextBlock Text="MAINTENANCE"
                                   Foreground="#FF4D6D"
                                   FontFamily="Bahnschrift, Segoe UI"
                                   FontWeight="Bold"
                                   FontSize="10"/>
                    </Border>
                </StackPanel>

                <Button Grid.Column="1" Width="26" Height="26"
                        Content="✕" FontSize="11" Foreground="#A1A1AA"
                        Background="Transparent" BorderThickness="0"
                        Cursor="Hand" Click="BtnClose_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#FF0033"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>

            <!-- Center Notice -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,10,0,10" HorizontalAlignment="Center">
                <TextBlock Text="⚠️ UNDER MAINTENANCE!"
                           FontFamily="Bahnschrift, Segoe UI"
                           FontWeight="Black"
                           FontSize="18"
                           HorizontalAlignment="Center">
                    <TextBlock.Foreground>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#FFFFFF" Offset="0.0"/>
                            <GradientStop Color="#FF3B60" Offset="1.0"/>
                        </LinearGradientBrush>
                    </TextBlock.Foreground>
                </TextBlock>

                <TextBlock Text="The application is currently disabled for maintenance."
                           Foreground="#D4D4D8"
                           FontSize="12"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,0"/>

                <TextBlock Text="Please check back later or visit Discord for announcements."
                           Foreground="#71717A"
                           FontSize="11"
                           HorizontalAlignment="Center"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Bottom Action -->
            <Button Grid.Row="2"
                    Height="36"
                    Content="CLOSE"
                    FontFamily="Bahnschrift, Segoe UI"
                    FontWeight="Bold"
                    FontSize="12"
                    Foreground="#FFFFFF"
                    Cursor="Hand"
                    Click="BtnClose_Click">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background">
                            <Setter.Value>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#80001A" Offset="0"/>
                                    <GradientStop Color="#FF0033" Offset="1"/>
                                </LinearGradientBrush>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="6"
                                            BorderThickness="0">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.88"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>
    </Border>
</Window>